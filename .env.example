# ==============================================================================
# ClipHunter AI - Configuração de Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais:
#   copy .env.example .env

# --- Google Gemini AI (Curadoria Multimodal e Enquadramento de Câmera) ---
# Obtenha sua chave de API gratuita no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Modo de Teste Rápido ---
# Se true, gera cortes a cada intervalo de tempo sem depender de picos de chat/áudio
MODO_TESTE=false
INTERVALO_TESTE_SEGUNDOS=45
AUTO_APROVAR=false

# --- Diretórios de Trabalho (Relativos à raiz do projeto) ---
BUFFER_DIR=buffer_temp
OUTPUT_DIR=prontos_para_postar

# --- Publicação / Ponte Mobile via Telegram (Reels, TikTok, Kwai) ---
# Crie um bot no Telegram com o @BotFather e obtenha seu ID com o @userinfobot
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=seu_telegram_chat_id_aqui

# --- Nível de Log (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
