# ==============================================================================
# ClipHunter AI - Git Ignore
# ==============================================================================

# Ambientes Virtuais Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Caches e Bytecode Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Arquivos de Ambiente e Credenciais Sensíveis (NUNCA COMMITAR)
.env
.env.*
!.env.example
client_secret*.json
token_youtube*.json
*.pickle
config/historico_uploads.json
config/preferencias.json

# Diretórios de Mídia e Arquivos Temporários
buffer/
buffer_temp/*
!buffer_temp/.gitkeep
cortes_temp/

# Vídeos Renderizados e Saída (Preserva apenas a pasta)
prontos_para_postar/*
!prontos_para_postar/.gitkeep

# Arquivos de Mídia e Legendas Avulsas
*.mp4
*.ts
*.mp3
*.wav
*.aac
*.ass
*.srt
*.jpg
*.jpeg
*.png

# Logs e Arquivos de Depuração
logs/*
!logs/.gitkeep
*.log
*.log.*

# IDEs e Ferramentas do Sistema Operacional
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
Desktop.ini
.DS_Store
.antigravity/
